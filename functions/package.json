{
  "name": "functions",
  "description": "Cloud Functions for Firebase",
  "scripts": {
    "serve": "firebase emulators:start --only functions",
    "shell": "firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log",
    "test": "node --test test/domain/activity/*.test.js test/domain/groups/*.test.js test/groups/*.test.js",
    "test:emulator": "cd .. && firebase emulators:exec --only auth,firestore,functions \"node functions/test-group-participation-emulator.mjs\""
  },
  "engines": {
    "node": "22"
  },
  "main": "index.js",
  "type": "module",
  "dependencies": {
    "firebase-admin": "^13.6.0",
    "firebase-functions": "^7.0.3"
  },
  "devDependencies": {
    "firebase-functions-test": "^3.1.0"
  },
  "private": true,
  "volta": {
    "node": "22.22.0"
  }
}
