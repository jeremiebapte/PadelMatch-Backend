{
  "functions": {
    "source": "functions"
  },
  "hosting": {
    "public": "public",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "headers": [
      {
        "source": "**/*",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "/.well-known/apple-app-site-association",
        "headers": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      }
    ],
    "redirects": [
      {
        "source": "/support/delete-account",
        "destination": "/delete-account.html",
        "type": 301
      },
      {
        "source": "/ios",
        "destination": "https://apps.apple.com/fr/app/padelmatch-pm/id6753951970?utm_source=web&utm_medium=redirect&utm_campaign=launch",
        "type": 302
      },
      {
        "source": "/android",
        "destination": "https://play.google.com/store/apps/details?id=com.bapoto.padelmatch&utm_source=web&utm_medium=redirect&utm_campaign=launch",
        "type": 302
      },
      {
        "source": "/app",
        "destination": "/index.html#download",
        "type": 302
      }
    ],
    "rewrites": [
      {
        "source": "/terms",
        "destination": "/terms.html"
      },
      {
        "source": "/privacy",
        "destination": "/privacy.html"
      },
      {
        "source": "/group/invite",
        "destination": "/index.html"
      },
      {
        "source": "/group/invite/**",
        "destination": "/index.html"
      }
    ]
  },
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "emulators": {
    "auth": {
      "host": "127.0.0.1",
      "port": 9099
    },
    "firestore": {
      "host": "127.0.0.1",
      "port": 8080
    },
    "functions": {
      "host": "127.0.0.1",
      "port": 5001
    },
    "ui": {
      "enabled": true,
      "host": "127.0.0.1",
      "port": 4000
    }
  }
}
