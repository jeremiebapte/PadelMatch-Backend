rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function uid()      { return request.auth.uid; }
    function onlyKeysChanged(allowed) {
      return request.resource.data.diff(resource.data).changedKeys().hasOnly(allowed);
    }
    function toMillis(v) {
      return (v is timestamp) ? v.toMillis()
           : (v is int)       ? v
           : (v is float)     ? int(v)
           : 0;
    }
    function userDoc() {
      return get(/databases/$(database)/documents/users/$(uid()));
    }
    function isClubAdmin(clubId) {
      return signedIn()
        && userDoc().data.role == 'club_admin'
        && userDoc().data.clubId == clubId;
    }

    function groupMembershipId(groupId, userId) {
      return groupId + '_' + userId;
    }

    function hasActiveGroupMembership(groupId) {
      return signedIn()
        && exists(
          /databases/$(database)/documents/groupMemberships/$(groupMembershipId(groupId, uid()))
        )
        && get(
          /databases/$(database)/documents/groupMemberships/$(groupMembershipId(groupId, uid()))
        ).data.userId == uid()
        && get(
          /databases/$(database)/documents/groupMemberships/$(groupMembershipId(groupId, uid()))
        ).data.groupId == groupId
        && get(
          /databases/$(database)/documents/groupMemberships/$(groupMembershipId(groupId, uid()))
        ).data.status == 'active';
    }

    function canManageGroupJoinRequests(groupId) {
      return signedIn()
        && exists(
          /databases/$(database)/documents/groupMemberships/$(groupMembershipId(groupId, uid()))
        )
        && get(
          /databases/$(database)/documents/groupMemberships/$(groupMembershipId(groupId, uid()))
        ).data.userId == uid()
        && get(
          /databases/$(database)/documents/groupMemberships/$(groupMembershipId(groupId, uid()))
        ).data.groupId == groupId
        && get(
          /databases/$(database)/documents/groupMemberships/$(groupMembershipId(groupId, uid()))
        ).data.status == 'active'
        && get(
          /databases/$(database)/documents/groupMemberships/$(groupMembershipId(groupId, uid()))
        ).data.role in ['owner', 'admin'];
    }

    match /users/{userId} {
      allow get, list: if signedIn();
      allow create: if signedIn()
        && userId == uid()
        && (request.resource.data.pseudo is string)
        && (request.resource.data.pseudoLower is string);
      allow update: if signedIn() && userId == uid()
        && onlyKeysChanged([
          'pseudo','pseudoLower',
          'avatar','niveau','notificationsEnabled',
          'nom','prenom','photoUrl','lat','lng','email',
          'createdAt','updatedAt',
          'fcmToken','fcmPlatform','fcmUpdatedAt',
          'onboardingCompleted','onboardingCompletedAt'
        ])
        && (
          !request.resource.data.diff(resource.data).changedKeys().hasAny(['createdAt'])
          || !('createdAt' in resource.data)
        );
      allow delete: if signedIn() && userId == uid();
      match /fcmTokens/{tokenId} {
        allow get, list: if signedIn() && userId == uid();
        allow create, update, delete: if signedIn() && userId == uid()
          && request.resource.data.keys().hasOnly(['platform','updatedAt'])
          && (request.resource.data.platform is string);
      }
    }

    match /usernames/{pseudoLower} {
      allow get, list: if true;

      allow create: if signedIn()
        && !exists(/databases/$(database)/documents/usernames/$(pseudoLower))
        && request.resource.data.keys()
             .hasOnly(['uid','createdAt','updatedAt'])
        && request.resource.data.uid == uid();

      allow update: if signedIn()
        && resource.data.uid == uid()
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.diff(resource.data)
             .changedKeys()
             .hasOnly(['updatedAt']);

      allow delete: if signedIn()
        && resource.data.uid == uid();
    }

    match /userAnalytics/{userId} {
      allow get: if signedIn() && userId == uid();

      allow create, update: if signedIn()
        && userId == uid()
        && request.resource.data.uid == uid();

      allow list, delete: if false;
    }

    /* ---------- Groups ---------- */

    match /groupMemberships/{membershipId} {
      allow get, list: if signedIn()
        && (
          resource.data.userId == uid()
          || (
            resource.data.status == 'active'
            && hasActiveGroupMembership(
              resource.data.groupId
            )
          )
        );

      allow create, update, delete: if false;
    }

    match /groupJoinRequests/{requestId} {
      /*
       * Lecture autorisée :
       * - au joueur ayant créé la demande ;
       * - aux Owner/Admin actifs du groupe concerné.
       *
       * Toute création ou résolution passe exclusivement
       * par les Cloud Functions.
       */
      allow get, list: if signedIn()
        && resource.data.groupId is string
        && resource.data.requesterUid is string
        && (
          resource.data.requesterUid == uid()
          || canManageGroupJoinRequests(
            resource.data.groupId
          )
        );

      allow create, update, delete: if false;
    }

    match /groups/{groupId} {
      allow get, list: if signedIn()
        && (
          hasActiveGroupMembership(groupId)
          || (
            resource.data.status == 'active'
            && resource.data.discoverability == 'searchable'
          )
        );

      allow create, update, delete: if false;
    }

    match /groupActivities/{activityId} {
      allow get, list: if signedIn()
        && resource.data.groupId is string
        && hasActiveGroupMembership(
          resource.data.groupId
        );

      allow create, update, delete: if false;
    }

    /* ---------- clubAvailabilities ---------- */
    match /clubAvailabilities/{availabilityId} {
      allow read: if true;
      allow create, update, delete: if false;
    }

    match /clubs/{clubId} {
      allow get, list: if signedIn();

      allow create, delete: if false;

      allow update: if isClubAdmin(clubId)
        && resource.data.adminUid == uid()
        && request.resource.data.adminUid == resource.data.adminUid
        && request.resource.data.status == resource.data.status
        && onlyKeysChanged([
          'name','city','address','latitude','longitude',
          'logoUrl','coverUrl','phone','email','website',
          'courtsCount','description','updatedAt'
        ]);
    }

    match /availableCourts/{courtId} {
      function validCourt(d) {
        return d.clubId is string
          && d.clubName is string
          && d.dateHeure is int
          && d.durationMinutes is int
          && d.playersNeeded is int
          && d.playersMax is int
          && d.status in ['available','converted','cancelled','expired']
          && d.latitude is number
          && d.longitude is number
          && d.city is string
          && d.address is string;
      }

      allow get, list: if signedIn();

      allow create: if signedIn()
        && validCourt(request.resource.data)
        && isClubAdmin(request.resource.data.clubId);

      allow update: if signedIn()
        && validCourt(request.resource.data)
        && isClubAdmin(resource.data.clubId)
        && request.resource.data.clubId == resource.data.clubId
        && request.resource.data.clubName == resource.data.clubName;

      allow delete: if false;
    }

    match /matches/{matchId} {
      function hasValidLevel(d) {
        return (d.level  is int && d.level  >= 1 && d.level  <= 10)
            || (d.niveau is int && d.niveau >= 1 && d.niveau <= 10);
      }
      function hasValidDate(d) { return toMillis(d.dateHeure) > 0; }
      function hasValidParticipants(d) {
        return (d.participants is list)
            && d.participants.size() >= 1
            && d.participants.size() <= 4;
      }
      function isOwner() { return signedIn() && resource.data.createurUid == uid(); }

      allow get, list: if signedIn();

      allow create: if signedIn()
        && request.resource.data.createurUid == uid()
        && hasValidLevel(request.resource.data)
        && hasValidDate(request.resource.data)
        && hasValidParticipants(request.resource.data)
        && request.resource.data.participants.size() <= 3
        && uid() in request.resource.data.participants;

      // Le créateur peut modifier les métadonnées, pas 'participants'
      allow update: if signedIn() && isOwner()
        && hasValidLevel(request.resource.data)
        && hasValidDate(request.resource.data)
        && hasValidParticipants(request.resource.data)
        && request.resource.data.participants == resource.data.participants
        && onlyKeysChanged([
          'lieu','placeId','latitude','longitude','dateHeure',
          'niveau','level','description','updatedAt',
          'createdByType','createdById','clubId','clubName','sourceAvailableCourtId'
        ])
        && request.resource.data.createurUid == resource.data.createurUid;

      // Toute autre update (join/leave) interdite côté client
      allow update: if false;

      allow delete: if signedIn() && isOwner();
    }

    match /clubReservations/{reservationId} {
      allow get, list: if signedIn()
        && (
          resource.data.playerUid == uid()
          || isClubAdmin(resource.data.clubId)
        );

      allow create, update, delete: if false;
    }

    match /messages/{messageId} {

      /*
       * Deux contextes sont conservés dans la collection commune messages :
       *
       * - conversation de match :
       *   matchId + senderUid + receiverUid
       *
       * - conversation de groupe :
       *   conversationType == "group" + groupId + senderUid
       */

      function isGroupMessage(data) {
        return data.groupId is string
          && (
            !('conversationType' in data)
            || data.conversationType == 'group'
          );
      }

      function isMatchMessage(data) {
        return data.matchId is string
          && data.receiverUid is string
          && (
            !('conversationType' in data)
            || data.conversationType == 'match'
          );
      }

      function hasValidMessageTimestamp(data) {
        return data.timestamp is timestamp
          || data.timestamp is int
          || data.timestamp is float;
      }

      function canReadGroupMessage(data) {
        return isGroupMessage(data)
          && hasActiveGroupMembership(data.groupId);
      }

      function canReadMatchMessage(data) {
        return isMatchMessage(data)
          && (
            data.senderUid == uid()
            || data.receiverUid == uid()
          );
      }

      /*
       * Lecture :
       * - les participants conservent l'accès aux messages privés ;
       * - tous les membres actifs peuvent lire les messages de leur groupe.
       */
      allow get, list: if signedIn()
        && (
          canReadGroupMessage(resource.data)
          || canReadMatchMessage(resource.data)
        );

      /*
       * Création d'un message de match.
       *
       * conversationType reste facultatif pour conserver la compatibilité
       * avec les anciens clients et les anciens documents.
       */
      allow create: if signedIn()
        && request.resource.data.senderUid == uid()
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && hasValidMessageTimestamp(request.resource.data)
        && isMatchMessage(request.resource.data);

      /*
       * Création d'un message de groupe.
       *
       * Seul un membre actif du groupe peut publier.
       */
      allow create: if signedIn()
        && request.resource.data.senderUid == uid()
        && request.resource.data.conversationType == 'group'
        && request.resource.data.groupId is string
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && hasValidMessageTimestamp(request.resource.data)
        && hasActiveGroupMembership(
          request.resource.data.groupId
        );

      /*
       * Modification :
       * - uniquement l'auteur ;
       * - uniquement le texte et les métadonnées d'édition ;
       * - le contexte, l'auteur et la date d'origine restent immuables.
       */
      allow update: if signedIn()
        && resource.data.senderUid == uid()
        && request.resource.data.senderUid == resource.data.senderUid
        && request.resource.data.diff(resource.data)
             .changedKeys()
             .hasOnly([
               'text',
               'edited',
               'editedAt'
             ])
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && (
          canReadMatchMessage(resource.data)
          || canReadGroupMessage(resource.data)
        );

      /*
       * Suppression :
       * - l'auteur peut supprimer son message ;
       * - pour les anciens messages privés, le destinataire conserve
       *   également le droit historique de suppression ;
       * - un message de groupe nécessite une appartenance active.
       */
      allow delete: if signedIn()
        && (
          (
            isGroupMessage(resource.data)
            && resource.data.senderUid == uid()
            && hasActiveGroupMembership(
              resource.data.groupId
            )
          )
          ||
          (
            isMatchMessage(resource.data)
            && (
              resource.data.senderUid == uid()
              || resource.data.receiverUid == uid()
            )
          )
        );
    }

    match /userCounters/{userId} {
      allow read: if signedIn() && userId == uid();
      allow write: if false;
    }

    match /fcmTokens/{userId} {
      allow read, write: if false;
    }
  }
}
